# =============================================================================
# SGDTS Spring Boot Backend — Supabase Connection Environment Variables
# =============================================================================
# In Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI:
# Choose either Method A (Session Pooler) or Method B (Direct Connection):

# Method A: Session / Transaction Pooler (Recommended - Port 6543 or 5432)
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REFERENCE_ID
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# Method B: Direct Database Connection (Port 5432)
# DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REFERENCE_ID.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# Hibernate auto-creation & Hikari connection pool size
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_FLYWAY_ENABLED=false
DB_POOL_SIZE=5

